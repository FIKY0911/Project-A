<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.jarvis.hud.controller.HUDController"
            prefWidth="1280.0" prefHeight="820.0"
            styleClass="root" stylesheets="@../css/jarvis_hud.css">

    <!-- TOP HEADER -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-padding: 12px 24px 8px 24px; -fx-background-color: rgba(3, 11, 23, 0.9);">
            <!-- Title & Branding with Iron Man Arc Reactor Icon -->
            <ImageView fitWidth="26.0" fitHeight="26.0" preserveRatio="true">
                <image>
                    <Image url="@../icons/app_icon_64x64.png"/>
                </image>
            </ImageView>
            <Label text="J . A . R . V . I . S ." styleClass="hud-title" style="-fx-font-size: 17px;"/>
            <Separator orientation="VERTICAL" style="-fx-background-color: #0d3859; -fx-pref-height: 16px;"/>
            <Label text="Just A Rather Very Intelligent System" styleClass="hud-subtitle" style="-fx-font-size: 13px;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Status Indicator -->
            <HBox alignment="CENTER" spacing="8.0">
                <Circle fx:id="connectionLed" radius="4.0" fill="#ff3344"/>
                <Label fx:id="connectionStatusLabel" text="OFFLINE" styleClass="hud-value-label" style="-fx-font-size: 11px;"/>
            </HBox>

            <Separator orientation="VERTICAL" style="-fx-background-color: #0d3859; -fx-pref-height: 16px;"/>

            <!-- Window Controls -->
            <Button text="—" onAction="#handleWindowMinimize" styleClass="win-control-btn"/>
            <Button text="✕" onAction="#handleWindowClose" styleClass="win-control-btn, win-close-btn"/>
        </HBox>
    </top>

    <!-- CENTER DASHBOARD GRID -->
    <center>
        <GridPane hgap="16.0" vgap="16.0" style="-fx-padding: 10px 24px 10px 24px;">
            <columnConstraints>
                <ColumnConstraints prefWidth="280.0" minWidth="260.0" maxWidth="320.0"/>
                <ColumnConstraints hgrow="ALWAYS"/>
                <ColumnConstraints prefWidth="290.0" minWidth="270.0" maxWidth="330.0"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints vgrow="ALWAYS"/>
            </rowConstraints>

            <!-- LEFT COLUMN -->
            <VBox spacing="14.0" GridPane.columnIndex="0">
                <!-- Panel 1: Voice Command -->
                <VBox spacing="8.0" styleClass="hud-card">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="VOICE COMMAND" styleClass="hud-title"/>
                    </HBox>
                    <StackPane fx:id="waveformContainer" prefHeight="50.0"/>
                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <Label fx:id="voiceCommandTranscriptLabel" text="Microphone LIVE: Waiting for 'Jarvis'..."
                               wrapText="true" styleClass="hud-text-muted" style="-fx-font-style: italic;" HBox.hgrow="ALWAYS"/>
                        <Label text="● MIC ALWAYS-ON" style="-fx-text-fill: #00f0ff; -fx-font-size: 10px; -fx-font-weight: bold; -fx-padding: 3px 6px; -fx-background-color: rgba(0,240,255,0.15); -fx-background-radius: 4px;"/>
                    </HBox>
                </VBox>

                <!-- Panel 2: System Status -->
                <VBox spacing="10.0" styleClass="hud-card">
                    <Label text="SYSTEM STATUS" styleClass="hud-title"/>

                    <!-- CPU -->
                    <VBox spacing="3.0">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="CPU Usage" styleClass="hud-text-muted"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="cpuLabel" text="12%" styleClass="hud-value-label"/>
                        </HBox>
                        <ProgressBar fx:id="cpuProgressBar" progress="0.12" maxWidth="Infinity" styleClass="hud-progress-bar"/>
                    </VBox>

                    <!-- RAM -->
                    <VBox spacing="3.0">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="RAM Usage" styleClass="hud-text-muted"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="ramLabel" text="42%" styleClass="hud-value-label"/>
                        </HBox>
                        <ProgressBar fx:id="ramProgressBar" progress="0.42" maxWidth="Infinity" styleClass="hud-progress-bar"/>
                    </VBox>

                    <!-- Disk -->
                    <VBox spacing="3.0">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Disk Usage" styleClass="hud-text-muted"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="diskLabel" text="28%" styleClass="hud-value-label"/>
                        </HBox>
                        <ProgressBar fx:id="diskProgressBar" progress="0.28" maxWidth="Infinity" styleClass="hud-progress-bar"/>
                    </VBox>

                    <!-- Network -->
                    <HBox alignment="CENTER_LEFT" spacing="6.0">
                        <Label text="Network" styleClass="hud-text-muted"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Circle fx:id="networkLed" radius="3.5" fill="#00ffaa"/>
                        <Label fx:id="networkStatusLabel" text="Connected" styleClass="hud-text-bright"/>
                    </HBox>
                </VBox>

                <!-- Panel 3: Quick Access -->
                <VBox spacing="6.0" styleClass="hud-card" VBox.vgrow="ALWAYS">
                    <Label text="QUICK ACCESS" styleClass="hud-title"/>
                    <Button text="🌐  Browser" maxWidth="Infinity" onAction="#handleQuickBrowser" styleClass="quick-access-btn"/>
                    <Button text="📁  Files" maxWidth="Infinity" onAction="#handleQuickFiles" styleClass="quick-access-btn"/>
                    <Button text="📝  Notepad" maxWidth="Infinity" onAction="#handleQuickNotepad" styleClass="quick-access-btn"/>
                    <Button text="🎵  Music" maxWidth="Infinity" onAction="#handleQuickMusic" styleClass="quick-access-btn"/>
                    <Button text="⚙️  Settings" maxWidth="Infinity" onAction="#handleOpenSettings" styleClass="quick-access-btn"/>

                    <Region VBox.vgrow="ALWAYS"/>
                    <Label text="J.A.R.V.I.S. v1.0" style="-fx-text-fill: #3b6b85; -fx-font-size: 10px;"/>
                </VBox>
            </VBox>

            <!-- CENTER COLUMN (Iron Man Core & Telemetry) -->
            <VBox spacing="8.0" GridPane.columnIndex="1" alignment="CENTER">
                <!-- Top Center Telemetry Indicators -->
                <HBox alignment="CENTER" spacing="24.0">
                    <VBox spacing="2.0">
                        <Label fx:id="statusAnalyzingLabel" text="ANALYZING..." style="-fx-text-fill: #00d2ff; -fx-font-weight: bold; -fx-font-size: 11px;"/>
                        <Label fx:id="statusProcessingLabel" text="PROCESSING..." style="-fx-text-fill: #00f0ff; -fx-font-weight: bold; -fx-font-size: 11px;"/>
                        <Label fx:id="statusReadyLabel" text="READY." style="-fx-text-fill: #00ffaa; -fx-font-weight: bold; -fx-font-size: 11px;"/>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <!-- Suit Telemetry Mini Box -->
                    <VBox spacing="3.0" style="-fx-padding: 6px 12px; -fx-background-color: rgba(7, 21, 41, 0.6); -fx-border-color: #0c3350; -fx-border-radius: 4px;">
                        <Label text="SUIT STATUS" style="-fx-text-fill: #5c8ca6; -fx-font-size: 9px; -fx-font-weight: bold;"/>
                        <HBox spacing="8.0" alignment="CENTER_LEFT">
                            <Label text="ARMOR" style="-fx-text-fill: #00d2ff; -fx-font-size: 9px;"/>
                            <ProgressBar progress="0.95" prefWidth="70.0" styleClass="hud-progress-bar"/>
                        </HBox>
                        <HBox spacing="8.0" alignment="CENTER_LEFT">
                            <Label text="POWER" style="-fx-text-fill: #00d2ff; -fx-font-size: 9px;"/>
                            <ProgressBar progress="0.88" prefWidth="70.0" styleClass="hud-progress-bar"/>
                        </HBox>
                        <HBox spacing="8.0" alignment="CENTER_LEFT">
                            <Label text="WEAPONS" style="-fx-text-fill: #00d2ff; -fx-font-size: 9px;"/>
                            <ProgressBar progress="1.0" prefWidth="70.0" styleClass="hud-progress-bar"/>
                        </HBox>
                    </VBox>
                </HBox>

                <!-- Security Alert Banner (Floating) -->
                <Label fx:id="securityAlertBanner" text="⚠️ SECURITY ALERT: PII INTERCEPTED"
                       style="-fx-background-color: rgba(255, 50, 70, 0.85); -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 6px 16px; -fx-background-radius: 6px;"/>

                <!-- Arc Reactor (Center Canvas) -->
                <StackPane fx:id="arcReactorContainer" VBox.vgrow="ALWAYS" alignment="CENTER" prefHeight="380.0"/>

                <!-- Bottom Telemetry & Radar widgets -->
                <HBox alignment="CENTER" spacing="20.0" style="-fx-padding: 4px 0 0 0;">
                    <!-- Global Network items -->
                    <VBox spacing="4.0" alignment="CENTER_LEFT">
                        <HBox spacing="6.0" alignment="CENTER_LEFT">
                            <Circle radius="3.0" fill="#00ffaa"/>
                            <Label text="GLOBAL NETWORK" style="-fx-text-fill: #5c8ca6; -fx-font-size: 10px;"/>
                        </HBox>
                        <HBox spacing="6.0" alignment="CENTER_LEFT">
                            <Circle radius="3.0" fill="#00ffaa"/>
                            <Label text="SATELLITE LINK" style="-fx-text-fill: #5c8ca6; -fx-font-size: 10px;"/>
                        </HBox>
                        <HBox spacing="6.0" alignment="CENTER_LEFT">
                            <Circle radius="3.0" fill="#00ffaa"/>
                            <Label text="LOCATION TRACKING" style="-fx-text-fill: #5c8ca6; -fx-font-size: 10px;"/>
                        </HBox>
                        <HBox spacing="6.0" alignment="CENTER_LEFT">
                            <Circle radius="3.0" fill="#00d2ff"/>
                            <Label text="DATA SYNC" style="-fx-text-fill: #5c8ca6; -fx-font-size: 10px;"/>
                        </HBox>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <!-- Circular Radar Widget -->
                    <Pane fx:id="radarContainer" prefWidth="110.0" prefHeight="110.0"/>
                </HBox>
            </VBox>

            <!-- RIGHT COLUMN -->
            <VBox spacing="14.0" GridPane.columnIndex="2">
                <!-- Panel 1: Clock & Date -->
                <VBox spacing="4.0" styleClass="hud-card" alignment="CENTER_LEFT">
                    <HBox alignment="CENTER_LEFT">
                        <Label fx:id="clockLabel" text="21:00" style="-fx-text-fill: #e6f7ff; -fx-font-size: 32px; -fx-font-weight: bold;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="📅" style="-fx-text-fill: #00d2ff; -fx-font-size: 18px;"/>
                    </HBox>
                    <Label fx:id="dateLabel" text="Monday, 16 September 2026" styleClass="hud-subtitle" style="-fx-font-size: 12px;"/>
                </VBox>

                <!-- Panel 2: Weather -->
                <VBox spacing="8.0" styleClass="hud-card">
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label text="☁️" style="-fx-font-size: 26px;"/>
                        <VBox spacing="2.0">
                            <Label text="Jakarta" styleClass="hud-title"/>
                            <Label text="Partly Cloudy" styleClass="hud-subtitle"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <VBox alignment="CENTER_RIGHT">
                            <Label text="28°C" style="-fx-text-fill: #e6f7ff; -fx-font-size: 22px; -fx-font-weight: bold;"/>
                            <Label text="H: 32° L: 24°" style="-fx-text-fill: #5c8ca6; -fx-font-size: 9px;"/>
                        </VBox>
                    </HBox>

                    <Separator style="-fx-background-color: #0c3350;"/>

                    <!-- 5-Day Forecast -->
                    <HBox alignment="CENTER" spacing="10.0">
                        <VBox alignment="CENTER" spacing="2.0">
                            <Label text="Tue" style="-fx-text-fill: #5c8ca6; -fx-font-size: 9px;"/>
                            <Label text="🌧" style="-fx-font-size: 11px;"/>
                            <Label text="32° 24°" style="-fx-text-fill: #5c8ca6; -fx-font-size: 8px;"/>
                        </VBox>
                        <VBox alignment="CENTER" spacing="2.0">
                            <Label text="Wed" style="-fx-text-fill: #5c8ca6; -fx-font-size: 9px;"/>
                            <Label text="🌧" style="-fx-font-size: 11px;"/>
                            <Label text="31° 24°" style="-fx-text-fill: #5c8ca6; -fx-font-size: 8px;"/>
                        </VBox>
                        <VBox alignment="CENTER" spacing="2.0">
                            <Label text="Thu" style="-fx-text-fill: #5c8ca6; -fx-font-size: 9px;"/>
                            <Label text="🌧" style="-fx-font-size: 11px;"/>
                            <Label text="30° 24°" style="-fx-text-fill: #5c8ca6; -fx-font-size: 8px;"/>
                        </VBox>
                        <VBox alignment="CENTER" spacing="2.0">
                            <Label text="Fri" style="-fx-text-fill: #5c8ca6; -fx-font-size: 9px;"/>
                            <Label text="🌧" style="-fx-font-size: 11px;"/>
                            <Label text="31° 24°" style="-fx-text-fill: #5c8ca6; -fx-font-size: 8px;"/>
                        </VBox>
                        <VBox alignment="CENTER" spacing="2.0">
                            <Label text="Sat" style="-fx-text-fill: #5c8ca6; -fx-font-size: 9px;"/>
                            <Label text="🌧" style="-fx-font-size: 11px;"/>
                            <Label text="32° 25°" style="-fx-text-fill: #5c8ca6; -fx-font-size: 8px;"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Panel 3: Recent Activity -->
                <VBox spacing="8.0" styleClass="hud-card" VBox.vgrow="ALWAYS">
                    <Label text="RECENT ACTIVITY" styleClass="hud-title"/>
                    <VBox fx:id="recentActivityList" spacing="6.0" VBox.vgrow="ALWAYS"/>
                </VBox>
            </VBox>
        </GridPane>
    </center>

    <!-- BOTTOM COMMAND INPUT CONSOLE -->
    <bottom>
        <HBox alignment="CENTER" spacing="12.0" style="-fx-padding: 6px 24px 18px 24px;">
            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="input-console-bar" HBox.hgrow="ALWAYS" maxWidth="720.0">
                <Label text="🎙" style="-fx-text-fill: #00f0ff; -fx-font-size: 16px; -fx-padding: 0 4px;"/>
                <TextField fx:id="promptInputField" promptText="Speak 'Jarvis [command]' or type here, Sir..." styleClass="hud-text-field" HBox.hgrow="ALWAYS"/>
                <Button fx:id="sendBtn" text="➤" onAction="#handleSendMessage" styleClass="hud-icon-btn"
                        style="-fx-min-width: 32px; -fx-min-height: 32px;"/>
            </HBox>

            <!-- Emergency Kill-Switch Button -->
            <Button fx:id="abortBtn" text="ABORT TASK" onAction="#handleEmergencyAbort" styleClass="hud-kill-switch"/>

            <Label text="I'm always here, sir." style="-fx-text-fill: #4c7793; -fx-font-size: 11px; -fx-font-style: italic;"/>
        </HBox>
    </bottom>
</BorderPane>
